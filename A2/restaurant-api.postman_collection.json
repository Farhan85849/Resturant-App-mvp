          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{MANAGER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Preparing\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/orders/ORDER_ID_HERE/status",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "orders", "ORDER_ID_HERE", "status"]
            }
          }
        }
      ]
