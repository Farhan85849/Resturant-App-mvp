            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {
          "name": "Get All Menu Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/menu",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "Filter Menu by Category & Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/menu?category=Mains&search=biryani",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "menu"],
              "query": [
                { "key": "category", "value": "Mains" },
                { "key": "search", "value": "biryani" }
              ]
            }
          }
        },
        {
          "name": "Get Menu Item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/menu/ITEM_ID_HERE",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "menu", "ITEM_ID_HERE"]
            }
          }
        },
        {
          "name": "Create Menu Item (Manager Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{MANAGER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chef Special Karahi\",\n  \"description\": \"Traditional mutton karahi cooked in wok.\",\n  \"price\": 1250,\n  \"category\": \"Mains\",\n  \"isSpecial\": true,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/menu",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "Update Menu Item Price/Availability (Manager Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{MANAGER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 950,\n  \"isAvailable\": false\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/menu/ITEM_ID_HERE",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "menu", "ITEM_ID_HERE"]
            }
          }
        },
        {
          "name": "Delete Menu Item (Manager Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{MANAGER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/menu/ITEM_ID_HERE",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "menu", "ITEM_ID_HERE"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{CUSTOMER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"menuItemId\": \"ITEM_ID_HERE\", \"quantity\": 2 }\n  ],\n  \"specialInstructions\": \"Less spicy please\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/orders",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Customer's Orders",
          "request": {
